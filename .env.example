# Copy this to `.env` and fill in. `.env` itself is gitignored because it holds
# SECRETS / SECRET_KEY; this template is the version that is safe to commit.

## Core
MAX_UPLOAD_MB = 25                  # Maximum upload size.
GUNICORN_WORKERS = 3                # Worker processes (threads are pinned to 1).

# Authentication
ALLOW_AUTH = false                  # Enable the accounts system.
REQUIRE_AUTH = false                # Gate every `/api/` call behind a session.
ALLOW_USER_REGISTRATION = true      # Allow self-registration.
ALLOW_GUEST_LOGIN = true            # Allow ephemeral guest sessions.
REQUIRE_SECRETS = true              # Refuse to start without `SECRETS`.
SECRETS =                           # Signing keys. Set both for stable sessions.
SECRET_KEY =                        # Signing keys. Set both for stable sessions.

# WebAuthn / passkeys - set RP_ID to your domain (no port)
RP_ID=localhost,font-builder*       # WebAuthn relying party id (domain, no port) and display name.
RP_NAME = localhost,font-builder*   # WebAuthn relying party id (domain, no port) and display name.   
ORIGIN=localhost,font-builder*      # Comma-separated accepted browser origins. **Set this in production.**

# Security
CORS_ALLOWED_ORIGINS=               # (same-origin) / `*`, or a comma-separated list.
TRUST_PROXY=true                    # Honour `X-Forwarded-*` behind a reverse proxy.

# JWT_TTL_SECONDS = 86400           # Session lifetime.
# GUEST_TTL_HOURS = 24              # Guest account lifetime.
# LOGIN_RATE_MAX = 5                # Attempts per window, per IP.
# REGISTER_RATE_MAX = 3             # Attempts per window, per IP.
